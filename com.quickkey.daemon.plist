<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quickkey.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/libexec/quickkeyd</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>UserName</key>
    <string>root</string>
    <key>GroupName</key>
    <string>wheel</string>

    <key>StandardOutPath</key>
    <string>/var/mobile/Library/Logs/QuickKey/daemon.out</string>
    <key>StandardErrorPath</key>
    <string>/var/mobile/Library/Logs/QuickKey/daemon.err</string>

    <key>ProcessType</key>
    <string>Interactive</string>
    <key>MachServices</key>
    <dict>
        <key>com.quickkey.daemon</key>
        <true/>
    </dict>
</dict>
</plist>
