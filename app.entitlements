<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ===== 让 App 脱离沙盒、以平台身份运行（TrollStore / 越狱专用） ===== -->
    <key>platform-application</key>
    <true/>
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    <key>com.apple.private.security.no-container</key>
    <true/>
    <key>com.apple.private.security.storage.AppDataContainers</key>
    <true/>

    <!-- ===== 关键：HID 事件监听权限，没有它监听不到音量键/电源键 ===== -->
    <key>com.apple.private.hid.client.event-monitor</key>
    <true/>
    <key>com.apple.private.hid.client.event-dispatch</key>
    <true/>

    <!-- ===== 打开 shortcuts:// 需要的 LaunchServices 私有权限 ===== -->
    <key>com.apple.private.launchservices</key>
    <true/>
    <key>com.apple.private.CoreServices.open-url</key>
    <true/>

    <!-- ===== 后台保活用的音频 ===== -->
    <key>com.apple.private.audio.session</key>
    <true/>

    <key>get-task-allow</key>
    <true/>
    <key>run-unsigned-code</key>
    <true/>
    <key>application-identifier</key>
    <string>com.quickkey.app</string>
    <key>com.apple.developer.team-identifier</key>
    <string>QUICKKEY</string>
</dict>
</plist>
